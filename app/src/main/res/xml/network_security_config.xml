<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">effectivegatecontent.com</domain>
        <domain includeSubdomains="true">adsterra.com</domain>
        <domain includeSubdomains="true">binance.com</domain>
        <domain includeSubdomains="true">binancepay.com</domain>
    </domain-config>
</network-security-config>
